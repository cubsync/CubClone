<?xml version="1.0" encoding="utf-8"?>
<!-- versionCode 不写在这里：app/build.sh 从 versionName 推导后传给 aapt2，见 docs/VERSIONING.md -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cubsync.cubclone"
    android:versionName="0.8.0-dev.20">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="33" />

    <!-- Shizuku 权限 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="CubClone"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="CubClone">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 设置：颜色模式 / 提权状态 / 分身空间管理 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <!-- 数据备份：列表 + 每项操作 -->
        <activity
            android:name=".BackupActivity"
            android:exported="false"
            android:label="@string/sec_backup" />

        <!-- 批量备份：选空间 → 勾应用 → 一次跑完 -->
        <activity
            android:name=".BatchBackupActivity"
            android:exported="false"
            android:label="@string/batch_backup_title" />

        <!-- Root 功能：总开关 + 单项开关 -->
        <activity
            android:name=".BatchRunActivity"
            android:exported="false"
            android:label="@string/batch_task_title" />

        <activity
            android:name=".RemoveClonesActivity"
            android:exported="false"
            android:label="@string/rc_title" />

        <activity
            android:name=".RootActivity"
            android:exported="false"
            android:label="@string/sec_root" />

        <!-- 分身空间管理：独立页，可滚动 + 批量删除/备份 -->
        <activity
            android:name=".SpacesActivity"
            android:exported="false"
            android:label="@string/sp_title" />

        <!-- 桌面快捷方式落地页：收到 uid/pkg 后直接启动分身里的应用 -->
        <activity
            android:name=".LaunchProxyActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Shizuku 必备：接收 binder -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.cubsync.cubclone.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
