<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/bk_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/bk_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:scaleType="fitCenter"
            android:contentDescription="返回" />

        <TextView
            android:id="@+id/bk_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/sec_backup"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 上一次批量任务的日志 -->
        <TextView
            android:id="@+id/bk_log"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/backup_log"
            android:textSize="13sp" />

        <!-- 新建备份（批量） -->
        <TextView
            android:id="@+id/bk_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="＋"
            android:textSize="20sp"
            android:visibility="gone" />

        <!-- 多选模式才显示 -->
        <TextView
            android:id="@+id/bk_sel_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/bk_sel_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/backup_sel_all"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/bk_sel_inv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/backup_invert"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/bk_sel_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="⋮"
            android:textSize="20sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 搜索 + 空间筛选 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <EditText
            android:id="@+id/bk_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/backup_search_hint"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp"
            android:background="@null" />

        <TextView
            android:id="@+id/bk_sort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/bk_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/bk_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:lineSpacingExtra="3dp"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bk_dir_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:background="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/bk_dir_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/backup_dir_row"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/bk_dir_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="start"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/bk_dir_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="&#8250;"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/bk_scope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="6dp"
        android:text="@string/backup_parts_note"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/bk_parts_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:background="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/bk_parts_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/backup_parts_row"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/bk_parts_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="start"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/bk_parts_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="&#8250;"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bk_algo_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:background="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/bk_algo_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/backup_algo_row"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/bk_algo_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/bk_algo_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- 导出 / 压缩时的进度：批量任务才显示 -->
    <LinearLayout
        android:id="@+id/bk_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/bk_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100" />

        <TextView
            android:id="@+id/bk_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:id="@+id/bk_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/bk_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/bk_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/backup_empty_hint"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
