<?xml version="1.0" encoding="utf-8"?>
<!-- 分身空间管理：独立页 + 可滚动列表 + 批量操作（设置页里只剩摘要和入口） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/sp_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:scaleType="fitCenter"
            android:contentDescription="@string/action_back" />

        <TextView
            android:id="@+id/sp_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/sp_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sp_select"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:minWidth="56dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="@string/sp_select"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/sp_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/sp_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp" />
    </ScrollView>

    <!-- 批量操作条：只在多选模式下出现 -->
    <LinearLayout
        android:id="@+id/sp_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/sp_all"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/sp_all"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sp_backup"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="@string/sp_backup"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sp_del"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="@string/delete_space"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
