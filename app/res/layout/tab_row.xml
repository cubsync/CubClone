<?xml version="1.0" encoding="utf-8"?>
<!-- 用户应用 / 系统应用 页签：动态挂到滚动内容顶部，随滑动滚走/回顶 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tab_row"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/tab_user"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/tab_user_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_user"
            android:textSize="15sp" />

        <View
            android:id="@+id/tab_user_line"
            android:layout_width="28dp"
            android:layout_height="2dp"
            android:layout_marginTop="5dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_sys"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/tab_sys_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_sys"
            android:textSize="15sp" />

        <View
            android:id="@+id/tab_sys_line"
            android:layout_width="28dp"
            android:layout_height="2dp"
            android:layout_marginTop="5dp" />
    </LinearLayout>
</LinearLayout>
